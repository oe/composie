{
  "compilerOptions": {
    "outDir": "./dist/",
    "sourceMap": false,
    "declaration": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": false,
    "target": "es6",
    "allowJs": false,
    "lib": [
      "dom",
      "es2020"
    ]
  },
  "include": [
    "./src/**/*.ts"
  ]
}
