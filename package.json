{
  "name": "composie",
  "version": "1.2.0",
  "description": "Koa-style middleware for named async operations, with channel routing, short-circuiting, and request/response results.",
  "main": "dist/composie.umd.js",
  "module": "dist/composie.es.js",
  "types": "dist/composie.d.ts",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "vite --open /test/web/",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.types.json",
    "build": "pnpm run clean && pnpm run typecheck && pnpm test && vite build && pnpm run build:types && pnpm run build:esm",
    "build:types": "tsc --emitDeclarationOnly --sourceMap false",
    "test:dist": "node scripts/test-dist.cjs && tsc --noEmit -p tsconfig.dist.json",
    "prepublishOnly": "pnpm run build && pnpm run test:dist",
    "build:esm": "node scripts/copy-esm.cjs"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://oe@github.com/oe/composie.git"
  },
  "keywords": [
    "middleware",
    "async-middleware",
    "middleware-composition",
    "middleware-router",
    "pipeline",
    "request-response",
    "event-bus",
    "typescript",
    "koa-compose",
    "composie"
  ],
  "author": {
    "name": "Saiya",
    "url": "https://github.com/oe"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oe/composie/issues"
  },
  "homepage": "https://github.com/oe/composie#readme",
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1"
}
